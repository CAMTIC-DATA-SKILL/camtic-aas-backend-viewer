# 이 파일을 .env 로 복사한 뒤 환경에 맞게 수정하세요. (.env 는 git 에 커밋되지 않습니다)
# 상대 경로는 레포 루트 기준으로 해석됩니다.

# AASX 파일을 읽어 올 폴더 (필수)
AASX_DATA_DIR=data/aasx

# OPC-UA 산출물(nodeset.xml, engineering.csv, syscfg.json) 저장 폴더
# 비우면 AASX_DATA_DIR 의 형제 경로(data/artifacts)를 사용합니다.
ARTIFACTS_DIR=data/artifacts

# 서버
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false
# 허용할 CORS Origin, 콤마로 구분 (예: http://localhost:5173,http://localhost:3000)
CORS_ORIGINS=*

# 로그
LOG_LEVEL=INFO
# 비워 두면 파일 로그를 남기지 않고 콘솔에만 출력합니다.
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================
# OPC UA Client (middleware_gateway_opc_ua 와 같은 키)
# ============================================================
# 서버 목록은 data/opcua/catalog.json (현장 주소는 catalog.local.json)
OPCUA_SERVER_ID=default
OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840
OPCUA_CLIENT_NAME=camtic_aas_backend_viewer
OPCUA_APPLICATION_URI=urn:camtic:aas:opcua:client

# 요청 응답 대기 시간(초)
OPCUA_TIMEOUT=4
# 서버 상태 확인(watchdog) 주기(초)
OPCUA_WATCHDOG_INTERVAL=1.0
# 세션 타임아웃(ms)
OPCUA_SESSION_TIMEOUT_MS=3600000

# 연결 유실 시 자동 재연결 (구독 자동 복구 포함)
OPCUA_AUTO_RECONNECT=true
OPCUA_RECONNECT_MAX_DELAY=30.0
# 최초 접속 실패 시 재시도 간격(초) / 횟수 (0 = 무제한)
OPCUA_CONNECT_RETRY_INTERVAL=2.0
OPCUA_CONNECT_MAX_RETRIES=3

# 비우면 Anonymous
OPCUA_USERNAME=
OPCUA_PASSWORD=

# None | Basic256Sha256 | Aes128Sha256RsaOaep | Aes256Sha256RsaPss | Basic256 | Basic128Rsa15
OPCUA_SECURITY_POLICY=None
OPCUA_SECURITY_MODE=SignAndEncrypt
OPCUA_CLIENT_CERT=
OPCUA_CLIENT_KEY=
OPCUA_SERVER_CERT=

# 구독 publishing / 샘플링 주기(ms)
OPCUA_SUBSCRIPTION_PERIOD_MS=500
OPCUA_SAMPLING_INTERVAL_MS=100
# 기본 구독 노드 (쉼표 구분). 예) ns=2;i=2,ns=2;s=Device1.Temperature
OPCUA_NODE_IDS=

# HDF7-9 수집기 HTTP (비우면 뷰어에서 URL 을 직접 입력)
COLLECTOR_URL=http://127.0.0.1:4100
# 실시간 REC CSV 저장 폴더 / 기록 간격(초)
RECORD_DIR=data/records
RECORD_INTERVAL=1.0
